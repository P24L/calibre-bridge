{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES6",
		"allowJs": true,
		"noImplicitAny": true,
		"moduleResolution": "node",
		"importHelpers": true,
		"strict": true,
		"lib": ["DOM", "ES6", "ES2017", "ES2020"]
	},
	"include": ["**/*.ts"]
}
